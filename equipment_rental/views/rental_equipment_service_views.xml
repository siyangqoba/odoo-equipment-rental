<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rental_service_tree" model="ir.ui.view">
        <field name="name">rental.equipment.service.tree</field>
        <field name="model">rental.equipment.service</field>
        <field name="arch" type="xml">
            <tree>
                <field name="date"/>
                <field name="equipment_id"/>
                <field name="service_type" widget="badge"
                       decoration-info="service_type == 'preventive'"
                       decoration-warning="service_type == 'repair'"/>
                <field name="description"/>
                <field name="technician_id" widget="many2one_avatar_user" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="cost" sum="Total"/>
            </tree>
        </field>
    </record>

    <record id="view_rental_service_form" model="ir.ui.view">
        <field name="name">rental.equipment.service.form</field>
        <field name="model">rental.equipment.service</field>
        <field name="arch" type="xml">
            <form string="Service Record">
                <sheet>
                    <group>
                        <group>
                            <field name="equipment_id"/>
                            <field name="service_type"/>
                            <field name="description" placeholder="e.g. Replaced brushes, greased chuck"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="technician_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="cost"/>
                            <field name="return_to_service"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Parts used, readings, follow-up needed..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_rental_service_search" model="ir.ui.view">
        <field name="name">rental.equipment.service.search</field>
        <field name="model">rental.equipment.service</field>
        <field name="arch" type="xml">
            <search>
                <field name="equipment_id"/>
                <field name="description"/>
                <filter name="preventive" string="Preventive" domain="[('service_type', '=', 'preventive')]"/>
                <filter name="repair" string="Repairs" domain="[('service_type', '=', 'repair')]"/>
                <separator/>
                <filter name="filter_date" string="Date" date="date"/>
                <group expand="0" string="Group By">
                    <filter name="group_equipment" string="Equipment" context="{'group_by': 'equipment_id'}"/>
                    <filter name="group_type" string="Type" context="{'group_by': 'service_type'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rental_service" model="ir.actions.act_window">
        <field name="name">Service Log</field>
        <field name="res_model">rental.equipment.service</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No services logged yet</p>
            <p>Log preventive services, repairs and inspections to keep equipment rentable.</p>
        </field>
    </record>

    <record id="action_rental_equipment_service_due" model="ir.actions.act_window">
        <field name="name">Service Due</field>
        <field name="res_model">rental.equipment</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="context">{'search_default_service_due': 1}</field>
    </record>
</odoo>
