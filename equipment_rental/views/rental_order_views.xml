<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rental_order_tree" model="ir.ui.view">
        <field name="name">rental.order.tree</field>
        <field name="model">rental.order</field>
        <field name="arch" type="xml">
            <tree decoration-danger="is_overdue" decoration-muted="state == 'cancelled'" sample="1">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="duration_days" string="Days"/>
                <field name="user_id" widget="many2one_avatar_user" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="is_overdue" column_invisible="1"/>
                <field name="amount_total" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-info="state in ('confirmed', 'ongoing')"
                       decoration-success="state in ('returned', 'invoiced')"
                       decoration-muted="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <record id="view_rental_order_form" model="ir.ui.view">
        <field name="name">rental.order.form</field>
        <field name="model">rental.order</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_pickup" type="object" string="Pick Up" class="btn-primary" invisible="state != 'confirmed'"/>
                    <button name="action_open_return_wizard" type="object" string="Return" class="btn-primary" invisible="state != 'ongoing'"/>
                    <button name="action_create_invoice" type="object" string="Create Invoice" class="btn-primary" invisible="state != 'returned'"/>
                    <button name="%(action_report_rental_order)d" type="action" string="Print Agreement" invisible="state in ('draft', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft', 'confirmed')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Quotation" invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,ongoing,returned,invoiced"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoice" type="object" class="oe_stat_button" icon="fa-pencil-square-o"
                                invisible="not invoice_id">
                            <span>Invoice</span>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Overdue" bg_color="text-bg-danger" invisible="not is_overdue"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="state not in ('draft', 'confirmed')"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="invoice_id" invisible="1"/>
                            <field name="is_overdue" invisible="1"/>
                        </group>
                        <group>
                            <field name="date_start" readonly="state not in ('draft', 'confirmed')"/>
                            <field name="date_end" readonly="state not in ('draft', 'confirmed')"/>
                            <field name="duration_days" string="Billable Days"/>
                            <field name="date_picked_up" invisible="not date_picked_up"/>
                            <field name="date_returned" invisible="not date_returned"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Equipment" name="lines">
                            <field name="line_ids" readonly="state not in ('draft', 'confirmed')">
                                <tree editable="bottom">
                                    <field name="equipment_id"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="daily_rate"/>
                                    <field name="weekly_rate" optional="show"/>
                                    <field name="monthly_rate" optional="hide"/>
                                    <field name="days"/>
                                    <field name="pricing_note"/>
                                    <field name="deposit"/>
                                    <field name="return_condition" column_invisible="parent.state not in ('returned', 'invoiced')"/>
                                    <field name="damage_charge" column_invisible="parent.state not in ('returned', 'invoiced')"/>
                                    <field name="damage_notes" optional="hide" column_invisible="parent.state not in ('returned', 'invoiced')"/>
                                    <field name="subtotal"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="currency_id" invisible="1"/>
                                <field name="amount_rental"/>
                                <field name="late_fee" invisible="not late_fee"/>
                                <field name="late_days" invisible="not late_days"/>
                                <field name="damage_invoiced" invisible="not damage_invoiced"/>
                                <field name="amount_total" class="oe_subtotal_footer_separator"/>
                                <field name="deposit_total" string="Deposit Held"/>
                                <field name="damage_total" invisible="not damage_total"/>
                                <field name="deposit_retained" invisible="not deposit_retained"/>
                                <field name="deposit_refund" invisible="state not in ('returned', 'invoiced')"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Delivery instructions, site contact..."/>
                            <separator string="Return Inspection"/>
                            <field name="return_notes" placeholder="Condition on return, missing accessories..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_rental_order_calendar" model="ir.ui.view">
        <field name="name">rental.order.calendar</field>
        <field name="model">rental.order</field>
        <field name="arch" type="xml">
            <calendar date_start="date_start" date_stop="date_end" color="partner_id" mode="month" event_open_popup="1">
                <field name="partner_id"/>
                <field name="amount_total"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="view_rental_order_pivot" model="ir.ui.view">
        <field name="name">rental.order.pivot</field>
        <field name="model">rental.order</field>
        <field name="arch" type="xml">
            <pivot sample="1">
                <field name="date_start" type="row" interval="month"/>
                <field name="state" type="col"/>
                <field name="amount_total" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_rental_order_graph" model="ir.ui.view">
        <field name="name">rental.order.graph</field>
        <field name="model">rental.order</field>
        <field name="arch" type="xml">
            <graph type="bar" sample="1">
                <field name="date_start" interval="month"/>
                <field name="amount_total" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_rental_order_search" model="ir.ui.view">
        <field name="name">rental.order.search</field>
        <field name="model">rental.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="line_ids" string="Equipment" filter_domain="[('line_ids.equipment_id', 'ilike', self)]"/>
                <filter name="my" string="My Rentals" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="quotations" string="Quotations" domain="[('state', '=', 'draft')]"/>
                <filter name="upcoming" string="Upcoming Pickups" domain="[('state', '=', 'confirmed')]"/>
                <filter name="ongoing" string="Out Now" domain="[('state', '=', 'ongoing')]"/>
                <filter name="overdue" string="Overdue" domain="[('is_overdue', '=', True)]"/>
                <filter name="to_invoice" string="To Invoice" domain="[('state', '=', 'returned')]"/>
                <separator/>
                <filter name="filter_date_start" string="Pickup Date" date="date_start"/>
                <group expand="0" string="Group By">
                    <filter name="group_customer" string="Customer" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_month" string="Pickup Month" context="{'group_by': 'date_start:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rental_order" model="ir.actions.act_window">
        <field name="name">Rental Orders</field>
        <field name="res_model">rental.order</field>
        <field name="view_mode">tree,form,calendar,pivot,graph</field>
        <field name="context">{'search_default_my': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first rental</p>
            <p>Book equipment for a customer, confirm it, then track pickup, return and invoicing.</p>
        </field>
    </record>

    <record id="action_rental_order_overdue" model="ir.actions.act_window">
        <field name="name">Overdue Returns</field>
        <field name="res_model">rental.order</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_overdue': 1}</field>
    </record>

    <record id="action_rental_order_to_invoice" model="ir.actions.act_window">
        <field name="name">To Invoice</field>
        <field name="res_model">rental.order</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_to_invoice': 1}</field>
    </record>
</odoo>
