<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Category -->
    <record id="view_rental_category_tree" model="ir.ui.view">
        <field name="name">rental.equipment.category.tree</field>
        <field name="model">rental.equipment.category</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="name"/>
                <field name="equipment_count"/>
            </tree>
        </field>
    </record>

    <record id="action_rental_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">rental.equipment.category</field>
        <field name="view_mode">tree</field>
    </record>

    <!-- Equipment -->
    <record id="view_rental_equipment_kanban" model="ir.ui.view">
        <field name="name">rental.equipment.kanban</field>
        <field name="model">rental.equipment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" quick_create="false" sample="1">
                <field name="id"/>
                <field name="state"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill">
                            <div class="o_kanban_image_fill_left d-none d-md-block"
                                 t-attf-style="background-image: url(#{kanban_image('rental.equipment', 'image_1920', record.id.raw_value)})"/>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <div class="text-muted"><field name="code"/> · <field name="category_id"/></div>
                                <div><field name="daily_rate" widget="monetary"/> / day</div>
                                <div class="text-muted small"><field name="rental_count"/> rentals</div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_rental_equipment_tree" model="ir.ui.view">
        <field name="name">rental.equipment.tree</field>
        <field name="model">rental.equipment</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'available'" decoration-warning="state == 'maintenance'"
                  decoration-info="state == 'rented'">
                <field name="code"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="serial_number" optional="hide"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="daily_rate"/>
                <field name="deposit" optional="show"/>
                <field name="rental_count" optional="show"/>
                <field name="total_revenue" sum="Revenue" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'available'"
                       decoration-info="state == 'rented'"
                       decoration-warning="state == 'maintenance'"/>
            </tree>
        </field>
    </record>

    <record id="view_rental_equipment_form" model="ir.ui.view">
        <field name="name">rental.equipment.form</field>
        <field name="model">rental.equipment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_send_to_maintenance" type="object" string="Send to Maintenance"
                            invisible="state != 'available'" groups="equipment_rental.group_rental_manager"/>
                    <button name="action_mark_available" type="object" string="Mark Available" class="btn-primary"
                            invisible="state != 'maintenance'" groups="equipment_rental.group_rental_manager"/>
                    <button name="action_retire" type="object" string="Retire"
                            invisible="state in ('rented', 'retired')" groups="equipment_rental.group_rental_manager"
                            confirm="Retire this equipment? It will be archived."/>
                    <field name="state" widget="statusbar" statusbar_visible="available,rented,maintenance"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_rentals" type="object" class="oe_stat_button" icon="fa-calendar">
                            <field name="rental_count" widget="statinfo" string="Rentals"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-money" disabled="1">
                            <field name="total_revenue" widget="statinfo" string="Revenue"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-clock-o" disabled="1">
                            <field name="utilisation_days" widget="statinfo" string="Days Rented"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Retired" bg_color="text-bg-danger" invisible="active"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_1920'}"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Makita Rotary Hammer Drill"/></h1>
                        <field name="code" class="text-muted"/>
                    </div>
                    <group>
                        <group>
                            <field name="category_id"/>
                            <field name="serial_number"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="daily_rate"/>
                            <field name="deposit"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Condition, accessories included, safety notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_rental_equipment_search" model="ir.ui.view">
        <field name="name">rental.equipment.search</field>
        <field name="model">rental.equipment</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('code', 'ilike', self), ('serial_number', 'ilike', self)]"/>
                <field name="category_id"/>
                <filter name="available" string="Available" domain="[('state', '=', 'available')]"/>
                <filter name="rented" string="Rented Out" domain="[('state', '=', 'rented')]"/>
                <filter name="maintenance" string="In Maintenance" domain="[('state', '=', 'maintenance')]"/>
                <separator/>
                <filter name="archived" string="Retired" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_category" string="Category" context="{'group_by': 'category_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_rental_equipment" model="ir.actions.act_window">
        <field name="name">Equipment</field>
        <field name="res_model">rental.equipment</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Add your first piece of rental equipment</p>
            <p>Track daily rates, deposits, availability and revenue per item.</p>
        </field>
    </record>
</odoo>
