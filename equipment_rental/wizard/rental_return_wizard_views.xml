<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_rental_return_wizard_form" model="ir.ui.view">
        <field name="name">rental.return.wizard.form</field>
        <field name="model">rental.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Return Inspection">
                <group>
                    <group>
                        <field name="order_id" readonly="1" force_save="1"/>
                        <field name="return_date"/>
                    </group>
                    <group>
                        <field name="currency_id" invisible="1"/>
                        <field name="late_days" invisible="not late_days"/>
                        <field name="late_fee" invisible="not late_fee"/>
                    </group>
                </group>
                <field name="line_ids">
                    <tree editable="bottom" create="0" delete="0">
                        <field name="order_line_id" column_invisible="1" force_save="1"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="equipment_id"/>
                        <field name="deposit"/>
                        <field name="condition"/>
                        <field name="damage_charge" readonly="condition == 'good'"/>
                        <field name="damage_notes" placeholder="What was damaged?"/>
                        <field name="send_to_maintenance" widget="boolean_toggle"/>
                    </tree>
                </field>
                <group class="oe_subtotal_footer">
                    <field name="damage_total"/>
                    <field name="deposit_total"/>
                    <field name="deposit_refund" class="oe_subtotal_footer_separator"/>
                    <field name="damage_invoiced"/>
                </group>
                <field name="notes" placeholder="General notes on the return: missing accessories, cleaning needed..."/>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm Return" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
